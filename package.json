{
  "name": "prep_buddy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "verify:mocks": "tsx scripts/verify-mocks-engine.ts && tsx scripts/verify-mocks-quant.ts && tsx scripts/verify-mocks-reasoning.ts --quiet && tsx scripts/verify-mocks-english.ts",
    "build:qbank": "tsx scripts/build-quant-seed.ts",
    "build:quadkeys": "tsx scripts/build-quad-keys.ts",
    "verify:qbank-export": "tsx scripts/verify-qb-export.ts",
    "verify:qbank-add": "tsx scripts/verify-qb-add.ts",
    "probe:qbank-solver": "tsx --env-file=.env.local scripts/probe-qb-solver.ts",
    "verify:qbank-sync": "tsx --env-file=.env.local scripts/verify-qb-sync.ts && tsx scripts/verify-qb-client-sync.ts",
    "verify:awareness": "tsx scripts/verify-awareness.ts",
    "verify:daily": "tsx scripts/verify-daily.ts",
    "verify:mnemonic": "tsx scripts/verify-mnemonic.ts",
    "verify:hindu": "tsx scripts/verify-hindu-vocab.ts",
    "verify:learn": "tsx scripts/verify-daily-learn.ts",
    "verify:usersync": "tsx scripts/verify-user-sync.ts",
    "verify:vedic": "tsx scripts/verify-vedic.ts",
    "verify:surds": "tsx scripts/verify-surds.ts",
    "verify:quadratic": "tsx scripts/verify-quadratic.ts",
    "verify:quadratic-bank": "tsx scripts/verify-quadratic-bank.ts",
    "verify:powers": "tsx scripts/verify-powers.ts",
    "verify:alpha-series": "tsx scripts/verify-alpha-series.ts",
    "verify:letter-pairs": "tsx scripts/verify-letter-pairs.ts",
    "verify:number-arrangement": "tsx scripts/verify-number-arrangement.ts",
    "verify:digit-operations": "tsx scripts/verify-digit-operations.ts",
    "verify:puzzle":"tsx scripts/verify-puzzle-solver.ts",
    "verify:family": "tsx scripts/verify-family-tree.ts",
    "verify:family-game": "tsx scripts/verify-family-game.ts",
    "verify:family-steps": "tsx scripts/verify-family-steps.ts",
    "verify:syllogism": "tsx scripts/verify-syllogism-solver.ts",
    "preview": "vite preview",
    "verify:qbank-delete": "tsx scripts/verify-qb-delete.ts"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
